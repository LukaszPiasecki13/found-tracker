# Copy to backend/.env and fill in. Never commit the real file.
ENVIRONMENT=development
DATABASE_URL=postgresql://user:password@localhost:5432/found_tracker
# Used by pytest only. Must point at a disposable database (see app/conftest.py).
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/found_tracker_test
SECRET_KEY=change-me-to-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:5173
